{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "claim_version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "validation",
        "reproduction",
        "attack"
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "independence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90000,
      "contentEncoding": "base64"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attack_class": {
      "enum": [
        "source_poisoning",
        "contradiction_injection",
        "assumption_violation"
      ]
    },
    "distance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "claim",
    "claim_version",
    "kind",
    "result",
    "source",
    "method",
    "run_id",
    "group",
    "weight",
    "quality",
    "reliability",
    "independence",
    "observed_at",
    "expires_at",
    "content_base64",
    "sha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "attack"
          }
        }
      },
      "then": {
        "required": [
          "attack_class",
          "distance"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "attack_class"
              ]
            },
            {
              "required": [
                "distance"
              ]
            }
          ]
        }
      }
    }
  ]
}
